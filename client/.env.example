# Stellar Network Configuration
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Deployed Smart Contract ID on Stellar Testnet
NEXT_PUBLIC_CONTRACT_ADDRESS=CBZ5KPEROYIQ2YDDACVIXUMWUIZAVND5A4N6W4LSQOH7YOF7ADO6GAHO

# ---------------------------------------------------------------------------
# Community Feedback Forum (optional)
#
# Postgres connection string for the forum. Neon is the expected provider: its
# compute scales to zero when idle and resumes automatically on the next
# request, so the forum still works after long periods of no traffic.
#
# Provision one at https://neon.com (or via the Vercel Marketplace, which
# populates DATABASE_URL for you), then run:
#     cd client && node scripts/init-db.mjs
#
# Leave this unset to run without the forum — the API reports it as
# unconfigured and the UI says so, rather than silently discarding posts.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-123456.region.aws.neon.tech/neondb?sslmode=require
